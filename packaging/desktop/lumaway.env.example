# Copy to ~/.config/lumaway/lumaway.env and fill the values locally.
# Do not commit real local credentials.

LUMAWAY_BRIDGE=192.168.1.108
LUMAWAY_CONFIG_VERSION=1
LUMAWAY_SYNC_MODE=video
# App language: system, en, or fr. The environment variable LUMAWAY_LANG also works.
LUMAWAY_LANG=system
# Optional; filled automatically after pairing or `lumaway bridge-info`
LUMAWAY_BRIDGE_ID=
LUMAWAY_AREA=TV
LUMAWAY_APP_KEY=replace-with-app-key
LUMAWAY_CLIENT_KEY=replace-with-client-key
LUMAWAY_PROFILE=default
# Deprecated compatibility alias; LUMAWAY_SYNC_MODE is the source of truth.
# LUMAWAY_PRESET=video-wayland
LUMAWAY_DURATION_MS=0
LUMAWAY_BRIGHTNESS=1.00
LUMAWAY_REACTIVITY=0.35
LUMAWAY_COLOR_PROFILE=vivid
LUMAWAY_AUTOSTART_SYNC=false
# LUMAWAY_HUE_PIN_CERTS=1
# LUMAWAY_HUE_PIN_MODE=spki
# LUMAWAY_DTLS_ALLOW_REMOTE=1
RUST_LOG=lumaway=info
