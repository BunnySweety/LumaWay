msgstr "Lister les profils de ~/.config/lumaway/profiles"

msgid "Listing capture profiles."
msgstr "Liste des profils de capture."

msgid "Log"
msgstr "Journal"

msgid "Measure capture quality for the configured zone"
msgstr "Mesurer la qualité de capture pour la zone configurée"

msgid "Measuring capture quality. Select the display in Portal."
msgstr "Mesure de la qualité de capture. Sélectionnez l'écran dans le portail."

msgid "Mode"
msgstr "Mode"

msgid "Mode {mode} ({preset})."
msgstr "Mode {mode} ({preset})."

msgid "No bridge found automatically."
msgstr "Aucun pont détecté automatiquement."

msgid "No capture profiles found."
msgstr "Aucun profil de capture trouvé."

msgid "No lights in this zone"
msgstr "Aucune lumière dans cette zone"

msgid "Open Settings"
msgstr "Ouvrir les réglages"

msgid "Open LumaWay when you sign in"
msgstr "Ouvrir LumaWay à la connexion"

msgid "Pair"
msgstr "Associer"

msgid "Test lights"
msgstr "Tester les lumières"

msgid "Testing lights with red."
msgstr "Test des lumières en rouge."

msgid "Light test completed."
msgstr "Test des lumières terminé."

msgid "error: bridge, zone, and pairing keys are required before testing lights"
msgstr "erreur : le pont, la zone et les clés d'association sont requis avant de tester les lumières"

msgid "error: light test failed: {message}"
msgstr "erreur : échec du test des lumières : {message}"

msgid "Pairing required"
msgstr "Association requise"

msgid "Pairing succeeded and keys were saved. Loading zones…"
msgstr "Association réussie et clés enregistrées. Chargement des zones…"

msgid "Pairing succeeded, but settings could not be saved: {error}"
msgstr "Association réussie, mais les réglages n'ont pas pu être enregistrés : {error}"

msgid "Pick an entertainment zone"
msgstr "Choisir une zone Entertainment"

msgid "Please wait…"
msgstr "Veuillez patienter…"

msgid "Press Pair in Settings"
msgstr "Appuyez sur Associer dans les réglages"

msgid "Press the physical button on the bridge, then wait."
msgstr "Appuyez sur le bouton physique du pont, puis patientez."

msgid "Press the physical button on the bridge, then wait. New pairing keys will replace the saved keys."
msgstr "Appuyez sur le bouton physique du pont, puis patientez. Les nouvelles clés remplaceront les clés enregistrées."

msgid "Probe capture backends and write the selected profile"
msgstr "Tester les backends de capture et écrire le profil sélectionné"

msgid "Retry"
msgstr "Réessayer"

msgid "Profile file in ~/.config/lumaway/profiles"
msgstr "Fichier de profil dans ~/.config/lumaway/profiles"

msgid "Profiles"
msgstr "Profils"

msgid "Quality"
msgstr "Qualité"

msgid "Reactivity"
msgstr "Réactivité"

msgid "Save"
msgstr "Enregistrer"

msgid "Saved zone"
msgstr "Zone enregistrée"

msgid "Searching bridge"
msgstr "Recherche du pont"

msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Start sync when app opens"
msgstr "Démarrer la synchronisation à l'ouverture"

msgid "Starting sync…"
msgstr "Démarrage de la synchronisation…"

msgid "Starts LumaWay automatically after desktop login."
msgstr "Démarre LumaWay automatiquement après la connexion au bureau."

msgid "Starts sync when the app launches"
msgstr "Démarre la synchronisation au lancement de l'application"

msgid "Stop syncing"
msgstr "Arrêter la synchronisation"

msgid "Stopping sync…"
msgstr "Arrêt de la synchronisation…"

msgid "Streaming key"
msgstr "Clé de streaming"

msgid "Sync"
msgstr "Synchronisation"

msgid "Sync events will appear here."
msgstr "Les événements de synchronisation apparaîtront ici."

msgid "Sync stopped"
msgstr "Synchronisation arrêtée"

msgid "Sync stopped unexpectedly."
msgstr "La synchronisation s'est arrêtée de manière inattendue."

msgid "Sync stopped unexpectedly ({status})."
msgstr "La synchronisation s'est arrêtée de manière inattendue ({status})."

msgid "Sync stopped unexpectedly: {error}"
msgstr "La synchronisation s'est arrêtée de manière inattendue : {error}"

msgid "Turn the selected zone on or off"
msgstr "Activer ou désactiver la zone sélectionnée"

msgid "Turn the Hue zone on or off. Start sync controls screen syncing."
msgstr "Active ou désactive la zone Hue. Démarrer la synchronisation contrôle la synchronisation écran."

msgid "Zone"
msgstr "Zone"

msgid "Zone ID"
msgstr "ID de zone"

msgid "Zone ID or name"
msgstr "ID ou nom de zone"

msgid "Zone off: {name} ({count} lights)."
msgstr "Zone éteinte : {name} ({count} lumières)."

msgid "Zone on: {name} ({count} lights). Press Start to run sync."
msgstr "Zone allumée : {name} ({count} lumières). Appuyez sur Démarrer pour lancer la synchronisation."

msgid "Zones loaded from the bridge"
msgstr "Zones chargées depuis le pont"

msgid "default"
msgstr "défaut"

msgid "error: bridge address and application key are required before loading zones"
msgstr "erreur : l'adresse du pont et la clé d'application sont requises avant de charger les zones"

msgid "error: bridge address is required before pairing"
msgstr "erreur : l'adresse du pont est requise avant l'association"

msgid "error: capture profile name is required"
msgstr "erreur : le nom du profil de capture est requis"

msgid "error: could not activate zone: {message}"
msgstr "erreur : impossible d'activer la zone : {message}"

msgid "error: could not deactivate zone: {message}"
msgstr "erreur : impossible de désactiver la zone : {message}"

msgid "error: saved Hue application key was rejected. Press the bridge button, then press Pair in Settings."
msgstr "erreur : la clé d'application Hue enregistrée a été refusée. Appuyez sur le bouton du pont, puis sur Associer dans les réglages."

msgid "error: zone is required before measuring capture quality"
msgstr "erreur : une zone est requise avant de mesurer la qualité de capture"

msgid "error: zone, bridge address, or application key missing"
msgstr "erreur : zone, adresse du pont ou clé d'application manquante"

msgid "n/a"
msgstr "n/d"

msgid "warning: could not save bridge id: {error}"
msgstr "avertissement : impossible d'enregistrer l'identifiant du pont : {error}"

msgid "{count} bridges detected. First selected: {ip}"
msgstr "{count} ponts détectés. Premier sélectionné : {ip}"

msgid "{count} lights syncing"
msgstr "{count} lumières synchronisées"

msgid "{count} zones loaded."
msgstr "{count} zones chargées."

msgid "— (load zones after pairing)"
msgstr "— (chargez les zones après l'association)"

msgid "Bridge address, zone, and pairing keys are required before sync can start."
msgstr "L'adresse du pont, la zone et les clés d'association sont requises avant de démarrer la synchronisation."

msgid "The Hue bridge button was not pressed before pairing."
msgstr "Le bouton du pont Hue n'a pas été pressé avant l'association."

msgid "Check that the bridge is powered on and reachable on the network."
msgstr "Vérifiez que le pont est allumé et joignable sur le réseau."

msgid "Check that xdg-desktop-portal and the desktop portal backend are running."
msgstr "Vérifiez que xdg-desktop-portal et le backend portail du bureau sont démarrés."

msgid "Check the details below, then try again."
msgstr "Vérifiez les détails ci-dessous, puis réessayez."

msgid "Choose the screen or window to sync"
msgstr "Choisissez l'écran ou la fenêtre à synchroniser"

msgid "Details: {details}"
msgstr "Détails : {details}"

msgid "Enable the zone switch, then start sync again."
msgstr "Activez l'interrupteur de zone, puis relancez la synchronisation."

msgid "Another Hue app may already be using this Entertainment zone."
msgstr "Une autre application Hue utilise peut-être déjà cette zone Entertainment."

msgid "The Hue bridge is unreachable."
msgstr "Le pont Hue est injoignable."

msgid "The Hue bridge connection was lost during sync."
msgstr "La connexion au pont Hue a été perdue pendant la synchronisation."

msgid "The Hue bridge rejected the saved pairing key."
msgstr "Le pont Hue a refusé la clé d'association enregistrée."

msgid "The Hue Entertainment connection failed."
msgstr "La connexion Hue Entertainment a échoué."

msgid "The screen capture stream stopped."
msgstr "Le flux de capture d'écran s'est arrêté."

msgid "LumaWay stopped sync after the computer resumed from sleep."
msgstr "LumaWay a arrêté la synchronisation après la sortie de veille de l'ordinateur."

msgid "Open Settings and run Quality or Calibrate."
msgstr "Ouvrez Réglages puis lancez Qualité ou Calibrer."

msgid "Open Settings, pair the bridge, and select an Entertainment zone."
msgstr "Ouvrez Réglages, associez le pont et sélectionnez une zone Entertainment."

msgid "Press the physical button on the bridge, then press Pair again."
msgstr "Appuyez sur le bouton physique du pont, puis appuyez à nouveau sur Associer."

msgid "Press Start to try again"
msgstr "Appuyez sur Démarrer pour réessayer"

msgid "Press the bridge button, then use Pair in Settings to create new keys."
msgstr "Appuyez sur le bouton du pont, puis utilisez Associer dans Réglages pour créer de nouvelles clés."

msgid "Screen capture is not available through the desktop portal."
msgstr "La capture d'écran n'est pas disponible via le portail du bureau."

msgid "Screen capture is too dark to sync reliably."
msgstr "La capture d'écran est trop sombre pour une synchronisation fiable."

msgid "Screen capture stopped"
msgstr "Capture d'écran arrêtée"

msgid "Screen selection was cancelled."
msgstr "La sélection de l'écran a été annulée."

msgid "Screen selected"
msgstr "Écran sélectionné"

msgid "Start sync again and choose the screen or window to sync."
msgstr "Relancez la synchronisation et choisissez l'écran ou la fenêtre à synchroniser."

msgid "Start sync again and reselect the screen in the portal dialog."
msgstr "Relancez la synchronisation et resélectionnez l'écran dans la fenêtre du portail."

msgid "Start sync again and reselect the screen if the portal asks."
msgstr "Relancez la synchronisation et resélectionnez l'écran si le portail le demande."

msgid "Check that the bridge is powered on and reachable, then start sync again."
msgstr "Vérifiez que le pont est allumé et joignable, puis relancez la synchronisation."

msgid "Stop sync, wait a few seconds, then start sync again."
msgstr "Arrêtez la synchronisation, attendez quelques secondes, puis relancez-la."

msgid "Stop the other Hue sync app or choose a different Entertainment zone."
msgstr "Arrêtez l'autre application Hue Sync ou choisissez une autre zone Entertainment."

msgid "No screen frames arrived from the selected source."
msgstr "Aucune image d'écran n'est arrivée depuis la source sélectionnée."

msgid "Something went wrong."
msgstr "Un problème est survenu."

msgid "Turn on the selected Entertainment zone before starting sync."
msgstr "Activez la zone Entertainment sélectionnée avant de démarrer la synchronisation."

msgid "Synchronize lights with a Wayland screen"
msgstr "Synchroniser les lumières avec un écran Wayland"

msgid "Sync Philips Hue Entertainment lights from the Linux desktop"
msgstr "Synchronise les lumières Philips Hue Entertainment depuis le bureau Linux"

msgid "Syncing"
msgstr "Synchronisation en cours"
