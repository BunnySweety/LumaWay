msgstr "Durée {duration_ms} ms (0 = jusqu'à l'arrêt)."

msgid "Filled in automatically"
msgstr "Rempli automatiquement"

msgid "Higher values react faster"
msgstr "Les valeurs plus hautes réagissent plus vite"

