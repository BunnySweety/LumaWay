msgstr "Impossible de lire le nom du pont : {message}"

msgid "Deactivate"
msgstr "Désactiver"

msgid "Discover"
msgstr "Découvrir"

msgid "First setup"
msgstr "Première configuration"

msgid "Find your Hue bridge."
msgstr "Trouvez votre pont Hue."

msgid "Press the bridge button, then pair LumaWay."
msgstr "Appuyez sur le bouton du pont, puis associez LumaWay."

msgid "Select an Entertainment zone."
msgstr "Sélectionnez une zone Entertainment."

msgid "Turn the zone on, then test lights."
msgstr "Activez la zone, puis testez les lumières."

msgid "Ready. Press Start sync."
msgstr "Prêt. Appuyez sur Démarrer la synchronisation."

