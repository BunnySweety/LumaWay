msgid "Light sync"
msgstr "Synchronisation lumineuse"

msgid "Settings"
msgstr "Réglages"

msgid "About"
msgstr "À propos"

msgid "Sync Philips Hue Entertainment lights from the Linux desktop. All processing stays local; no telemetry. Philips Hue is mentioned only to identify compatible hardware; LumaWay is not affiliated with Signify."
msgstr "Synchronise les lumières Philips Hue Entertainment depuis le bureau Linux. Tout le traitement reste local ; aucune télémétrie. Philips Hue est mentionné uniquement pour identifier le matériel compatible ; LumaWay n'est pas affilié à Signify."

msgid "Start sync"
msgstr "Démarrer la synchronisation"

msgid "Stop sync"
msgstr "Arrêter la synchronisation"

msgid "Stop sync before changing mode"
msgstr "Arrêtez la synchronisation avant de changer de mode"

msgid "Video"
msgstr "Vidéo"

msgid "Game"
msgstr "Jeu"

msgid "Desktop"
msgstr "Bureau"

msgid "Music"
msgstr "Musique"

msgid "Coming soon"
msgstr "Bientôt"

